<template>
  <view class="page">
    <!-- 地图容器 -->
    <view class="map-container">
      <map 
        id="myMap"
        class="map"
        :latitude="latitude"
        :longitude="longitude"
        :scale="scale"
        :markers="markers"
        :polyline="polyline"
        show-location
        show-compass
        enable-zoom
        enable-scroll
        @markertap="onMarkerTap"
        @regionchange="onRegionChange">
      </map>
      
      <!-- 地图控制按钮 -->
      <view class="map-controls">
        <view class="control-btn" @tap="locateMe">
          <text class="icon">📍</text>
          <text class="text">定位</text>
        </view>
        <view class="control-btn" @tap="zoomIn">
          <text class="icon">➕</text>
          <text class="text">放大</text>
        </view>
        <view class="control-btn" @tap="zoomOut">
          <text class="icon">➖</text>
          <text class="text">缩小</text>
        </view>
        <view class="control-btn" @tap="openDestinationPanel">
          <text class="icon">🎯</text>
          <text class="text">目的地</text>
        </view>
      </view>
      
      <!-- 搜索框 -->
      <view class="search-container">
        <input 
          class="search-input" 
          placeholder="搜索地点或地址"
          v-model="searchKeyword"
          @confirm="searchPlace">
        <view class="search-btn" @tap="searchPlace">
          <text class="search-icon">🔍</text>
        </view>
      </view>
      
      <!-- 目的地设置面板 -->
      <view class="destination-panel" v-if="showDestinationPanel">
        <view class="panel-header">
          <text class="title">目的地设置</text>
          <text class="close" @tap="closeDestinationPanel">✕</text>
        </view>
        
        <view class="destination-form">
          <view class="form-group">
            <text class="label">当前位置</text>
            <input 
              class="input" 
              v-model="currentPosition"
              placeholder="点击下方按钮获取"
              :disabled="true">
          </view>
          
          <view class="form-group">
            <text class="label">目的地</text>
            <input 
              class="input" 
              v-model="destination"
              placeholder="输入地址或坐标（纬度,经度）"
              @confirm="confirmDestination">
          </view>
          
          <view class="button-group">
            <view class="btn get-location" @tap="getCurrentLocation">
              <text class="btn-icon">📍</text>
              <text class="btn-text">获取当前位置</text>
            </view>
            <view class="btn select-on-map" @tap="confirmDestination">
              <text class="btn-icon">✅</text>
              <text class="btn-text">确认目的地</text>
            </view>
          </view>
          
          <view class="route-info" v-if="routeInfo.distance">
            <text class="info-item">距离: {{routeInfo.distance}}km</text>
            <text class="info-item">时间: {{routeInfo.duration}}min</text>
            <text class="info-item">模式: {{routeInfo.mode}}</text>
          </view>
          
          <view class="action-buttons">
            <view class="action-btn plan-route" @tap="planRoute">
              <text class="action-icon">🚶</text>
              <text class="action-text">规划路线</text>
            </view>
            <view class="action-btn send-to-device" @tap="sendToDevice" :class="{disabled: !destinationMarker}">
              <text class="action-icon">📱</text>
              <text class="action-text">发送到设备</text>
            </view>
            <view class="action-btn clear-route" @tap="clearRoute">
              <text class="action-icon">🗑️</text>
              <text class="action-text">清除路线</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部坐标信息 -->
    <view class="bottom-info">
      <view class="info-content">
        <text class="coord">纬度: {{latitude.toFixed(6)}}</text>
        <text class="coord">经度: {{longitude.toFixed(6)}}</text>
        <text class="scale-text">缩放: {{scale}}</text>
      </view>
    </view>
  </view>
</template>

<script>
import { BASE } from '@/config/server.js'
const AMAP_KEY = 'c216de193661bf95f9891763d1837c8f'
const ROBOT_API = BASE

export default {
  data() {
    return {
      latitude: 32.1230155,
      longitude: 118.93069167,
      scale: 16,
      markers: [],
      polyline: [],
      routeInfo: { distance: 0, duration: 0, mode: '步行' },
      searchKeyword: '',
      showDestinationPanel: false,
      currentPosition: '',
      destination: '',
      destinationMarker: null,
      mapContext: null
    }
  },

  onShow() {
    this.initMap()
  },

  onHide() {
    this.mapContext = null
  },

  methods: {
    initMap() {
      this.mapContext = uni.createMapContext('myMap', this)
      this.getCurrentLocation()
    },

    getCurrentLocation() {
      uni.getLocation({
        type: 'gcj02',
        success: (res) => {
          this.latitude = res.latitude
          this.longitude = res.longitude
          this.currentPosition = res.latitude.toFixed(6) + ',' + res.longitude.toFixed(6)
          if (this.mapContext) this.mapContext.moveToLocation()
        },
        fail: () => {
          uni.showToast({ title: '获取位置失败，请检查权限', icon: 'none' })
        }
      })
    },

    locateMe() {
      this.getCurrentLocation()
    },

    zoomIn() {
      if (this.scale < 20) this.scale++
    },

    zoomOut() {
      if (this.scale > 3) this.scale--
    },

    onMarkerTap(e) {
      const marker = this.markers.find(m => m.id === e.markerId)
      if (marker) {
        uni.showModal({
          title: marker.title || '位置',
          content: '纬度: ' + marker.latitude.toFixed(6) + '\n经度: ' + marker.longitude.toFixed(6),
          showCancel: true,
          cancelText: '取消',
          confirmText: '设为目的地',
          success: (res) => {
            if (res.confirm) {
              this.addDestinationMarker(marker.latitude, marker.longitude)
              this.destination = marker.latitude.toFixed(6) + ',' + marker.longitude.toFixed(6)
            }
          }
        })
      }
    },

    onRegionChange(e) {
      if (e.type === 'end' && this.mapContext) {
        this.mapContext.getCenterLocation({
          success: (res) => {
            this.latitude = res.latitude
            this.longitude = res.longitude
          }
        })
      }
    },

    openDestinationPanel() { this.showDestinationPanel = true },
    closeDestinationPanel() { this.showDestinationPanel = false },

    searchPlace() {
      const kw = (this.searchKeyword || '').trim()
      if (!kw) { uni.showToast({ title: '请输入搜索关键词', icon: 'none' }); return }
      uni.showLoading({ title: '搜索中...' })
      uni.request({
        url: 'https://restapi.amap.com/v3/place/text',
        method: 'GET',
        data: { keywords: kw, key: AMAP_KEY, output: 'json', offset: 5 },
        timeout: 8000,
        success: (res) => {
          uni.hideLoading()
          if (res.data && res.data.status === '1' && res.data.pois && res.data.pois.length > 0) {
            const poi = res.data.pois[0]
            const parts = poi.location.split(',')
            const lng = parseFloat(parts[0])
            const lat = parseFloat(parts[1])
            this.latitude = lat
            this.longitude = lng
            this.scale = 16
            this.addDestinationMarker(lat, lng)
            this.destination = lat.toFixed(6) + ',' + lng.toFixed(6)
            uni.showToast({ title: '已定位到: ' + poi.name, icon: 'none', duration: 2000 })
          } else {
            uni.showToast({ title: '未找到相关地点', icon: 'none' })
          }
        },
        fail: () => {
          uni.hideLoading()
          uni.showToast({ title: '搜索失败，请检查网络', icon: 'none' })
        }
      })
    },

    confirmDestination() {
      const input = (this.destination || '').trim()
      if (!input) { uni.showToast({ title: '请输入目的地', icon: 'none' }); return }
      // 判断是否是坐标格式 lat,lng
      const coordReg = /^[-+]?\d+(\.\d+)?,\s*[-+]?\d+(\.\d+)?$/
      if (coordReg.test(input)) {
        const parts = input.split(',')
        const lat = parseFloat(parts[0])
        const lng = parseFloat(parts[1])
        this.addDestinationMarker(lat, lng)
      } else {
        // 当作地址，调用地理编码
        this.geocodeAddress(input)
      }
    },

    geocodeAddress(address) {
      uni.showLoading({ title: '解析地址...' })
      uni.request({
        url: 'https://restapi.amap.com/v3/geocode/geo',
        method: 'GET',
        data: { address: address, key: AMAP_KEY, output: 'json' },
        timeout: 8000,
        success: (res) => {
          uni.hideLoading()
          if (res.data && res.data.status === '1' && res.data.geocodes && res.data.geocodes.length > 0) {
            const loc = res.data.geocodes[0].location
            const parts = loc.split(',')
            const lng = parseFloat(parts[0])
            const lat = parseFloat(parts[1])
            this.addDestinationMarker(lat, lng)
            this.destination = lat.toFixed(6) + ',' + lng.toFixed(6)
          } else {
            uni.showToast({ title: '地址解析失败', icon: 'none' })
          }
        },
        fail: () => {
          uni.hideLoading()
          uni.showToast({ title: '网络错误', icon: 'none' })
        }
      })
    },

    addDestinationMarker(lat, lng) {
      this.markers = this.markers.filter(m => m.id !== 999)
      this.markers.push({
        id: 999,
        latitude: lat,
        longitude: lng,
        title: '目的地',
        width: 40,
        height: 40
      })
      this.destinationMarker = { latitude: lat, longitude: lng }
      uni.showToast({ title: '目的地已设置', icon: 'success' })
    },

    planRoute() {
      if (!this.currentPosition) {
        uni.showToast({ title: '请先获取当前位置', icon: 'none' }); return
      }
      if (!this.destinationMarker) {
        uni.showToast({ title: '请先设置目的地', icon: 'none' }); return
      }
      uni.showLoading({ title: '规划路线...' })
      const parts = this.currentPosition.split(',')
      const origin = parts[1].trim() + ',' + parts[0].trim() // amap: lng,lat
      const dest = this.destinationMarker.longitude + ',' + this.destinationMarker.latitude
      uni.request({
        url: 'https://restapi.amap.com/v3/direction/walking',
        method: 'GET',
        data: { origin: origin, destination: dest, key: AMAP_KEY, output: 'json' },
        timeout: 10000,
        success: (res) => {
          uni.hideLoading()
          if (res.data && res.data.status === '1' && res.data.route && res.data.route.paths && res.data.route.paths.length > 0) {
            const path = res.data.route.paths[0]
            this.routeInfo = {
              distance: (path.distance / 1000).toFixed(2),
              duration: Math.ceil(path.duration / 60),
              mode: '步行'
            }
            this.drawRoute(path.steps)
            uni.showToast({ title: '路线规划成功', icon: 'success' })
          } else {
            uni.showToast({ title: '路线规划失败', icon: 'none' })
          }
        },
        fail: () => {
          uni.hideLoading()
          uni.showToast({ title: '网络错误', icon: 'none' })
        }
      })
    },

    drawRoute(steps) {
      const points = []
      steps.forEach(step => {
        if (!step.polyline) return
        step.polyline.split(';').forEach(pt => {
          const p = pt.split(',')
          if (p.length === 2) {
            points.push({ latitude: parseFloat(p[1]), longitude: parseFloat(p[0]) })
          }
        })
      })
      this.polyline = [{ points: points, color: '#008c8c', width: 6, dottedLine: false }]
    },

    sendToDevice() {
      if (!this.destinationMarker) {
        uni.showToast({ title: '请先设置目的地', icon: 'none' }); return
      }
      uni.showModal({
        title: '发送目的地',
        content: '将目的地发送到巡检机器人？\n纬度: ' + this.destinationMarker.latitude.toFixed(6) + '\n经度: ' + this.destinationMarker.longitude.toFixed(6),
        success: (res) => {
          if (res.confirm) this.sendDestinationToRobot()
        }
      })
    },

    sendDestinationToRobot() {
      uni.showLoading({ title: '发送中...' })
      uni.request({
        url: ROBOT_API + '/destination/set',
        method: 'POST',
        data: {
          longitude: this.destinationMarker.longitude,
          latitude: this.destinationMarker.latitude,
          distance: this.routeInfo.distance || 0,
          duration: this.routeInfo.duration || 0
        },
        header: { 'Content-Type': 'application/json' },
        timeout: 8000,
        success: (res) => {
          uni.hideLoading()
          if (res.statusCode === 200 && res.data && res.data.success) {
            uni.showToast({ title: '目的地已发送', icon: 'success' })
          } else {
            uni.showToast({ title: (res.data && res.data.message) || '发送失败', icon: 'none' })
          }
        },
        fail: () => {
          uni.hideLoading()
          uni.showToast({ title: '无法连接到机器人服务器', icon: 'none' })
        }
      })
    },

    clearRoute() {
      this.polyline = []
      this.routeInfo = { distance: 0, duration: 0, mode: '步行' }
      this.markers = this.markers.filter(m => m.id !== 999)
      this.destinationMarker = null
      this.destination = ''
      uni.showToast({ title: '已清除路线', icon: 'success' })
    }
  }
}
</script>

<style scoped>
