<template>
  <view class="page" 
        :style="{ transform: `translateX(${translateX}px)`, transition: 'transform 0.1s ease' }"
        @touchstart="onTouchStart" 
        @touchmove="onTouchMove" 
        @touchend="onTouchEnd">
    
    <!-- 地图容器 -->
    <view class="map-container">
      <!-- 使用微信小程序地图组件 -->
      <map 
        id="myMap"
        class="map"
        :latitude="latitude"
        :longitude="longitude"
        :scale="scale"
        :markers="markers"
        :polyline="polyline"
        :controls="controls"
        show-location
        show-compass
        enable-3D
        enable-overlooking
        enable-zoom
        enable-scroll
        enable-rotate
        @markertap="onMarkerTap"
        @controltap="onControlTap"
        @regionchange="onRegionChange">
      </map>
      
      <!-- 地图控制按钮 -->
      <view class="map-controls">
        <view class="control-btn" @tap="locateMe">
          <text class="icon">📍</text>
          <text class="text">我的位置</text>
        </view>
        <view class="control-btn" @tap="toggleMapType">
          <text class="icon">🗺️</text>
          <text class="text">{{mapTypeText}}</text>
        </view>
        <view class="control-btn" @tap="zoomIn">
          <text class="icon">➕</text>
          <text class="text">放大</text>
        </view>
        <view class="control-btn" @tap="zoomOut">
          <text class="icon">➖</text>
          <text class="text">缩小</text>
        </view>
      </view>
      
      <!-- 搜索框 -->
      <view class="search-container">
        <input 
          class="search-input" 
          placeholder="搜索地点或地址"
          v-model="searchKeyword"
          @confirm="searchPlace"
          @focus="onSearchFocus"
          @blur="onSearchBlur">
        <view class="search-btn" @tap="searchPlace">
          <text class="search-icon">🔍</text>
        </view>
      </view>
      
      <!-- 目的地设置 -->
      <view class="destination-panel" v-if="showDestinationPanel">
        <view class="panel-header">
          <text class="title">目的地设置</text>
          <text class="close" @tap="closeDestinationPanel">✕</text>
        </view>
        
        <view class="destination-form">
          <view class="form-group">
            <text class="label">当前位置</text>
            <input 
              class="input" 
              v-model="currentPosition"
              placeholder="点击下方按钮获取"
              readonly>
          </view>
          
          <view class="form-group">
            <text class="label">目的地</text>
            <input 
              class="input" 
              v-model="destination"
              placeholder="输入地址或选择地图上的位置"
              @confirm="confirmDestination">
          </view>
          
          <view class="button-group">
            <view class="btn get-location" @tap="getCurrentLocation">
              <text class="btn-icon">📍</text>
              <text class="btn-text">获取当前位置</text>
            </view>
            <view class="btn select-on-map" @tap="selectOnMap">
              <text class="btn-icon">🗺️</text>
              <text class="btn-text">地图上选择</text>
            </view>
          </view>
          
          <view class="route-info" v-if="routeInfo.distance">
            <text class="info-item">距离: {{routeInfo.distance}}公里</text>
            <text class="info-item">时间: {{routeInfo.duration}}分钟</text>
            <text class="info-item">模式: {{routeInfo.mode}}</text>
          </view>
          
          <view class="action-buttons">
            <view class="action-btn plan-route" @tap="planRoute">
              <text class="action-icon">🚶</text>
              <text class="action-text">规划路线</text>
            </view>
            <view class="action-btn send-to-device" @tap="sendToDevice" :class="{disabled: !routeInfo.distance}">
              <text class="action-icon">📱</text>
              <text class="action-text">发送到设备</text>
            </view>
            <view class="action-btn clear-route" @tap="clearRoute">
              <text class="action-icon">🗑️</text>
              <text class="action-text">清除路线</text>
            </view>
          </view>
        </view>
      </view>
    </view>
    
    <!-- 底部信息栏 -->
    <view class="bottom-info" v-if="showBottomInfo">
      <view class="info-content">
        <view class="location-info">
          <text class="coord">纬度: {{latitude.toFixed(6)}}</text>
          <text class="coord">经度: {{longitude.toFixed(6)}}</text>
        </view>
        <view class="map-info">
          <text class="scale">比例尺: {{scale}}</text>
          <text class="markers">标记数: {{markers.length}}</text>
        </view>
      </view>
      <view class="toggle-info" @tap="toggleBottomInfo">
        <text class="toggle-icon">{{showBottomInfo ? '👇' : '👆'}}</text>
      </view>
    </view>
  </view>
</template>

<script>
import tabSwipe from '@/mixins/tabSwipe.js'

// 高德地图API配置（需要申请自己的key）
const AMAP_KEY = 'YOUR_AMAP_KEY_HERE' // 请替换为你的高德地图key

export default {
  mixins: [tabSwipe],
  data() {
    return {
      pagePath: '/pages/navigation/navigation',
      
      // 地图基础设置
      latitude: 32.1230155, // 默认纬度
      longitude: 118.93069167, // 默认经度
      scale: 16,
      mapType: 0, // 0-标准, 1-卫星
      
      // 地图标记
      markers: [
        {
          id: 1,
          latitude: 32.1230155,
          longitude: 118.93069167,
          title: '园区中心',
          iconPath: '/static/map/marker.png',
          width: 30,
          height: 40,
          callout: {
            content: '园区智能监控中心\n点击查看详情',
            color: '#333333',
            fontSize: 14,
            borderRadius: 4,
            borderWidth: 1,
            borderColor: '#008c8c',
            bgColor: '#ffffff',
            padding: 8,
            display: 'ALWAYS'
          }
        },
        {
          id: 2,
          latitude: 32.1232155,
          longitude: 118.93089167,
          title: '机器人A',
          iconPath: '/static/map/robot.png',
          width: 35,
          height: 35,
          label: {
            content: '🔋85%',
            color: '#008c8c',
            fontSize: 12,
            bgColor: '#ffffff',
            borderRadius: 8,
            padding: 4,
            borderWidth: 1,
            borderColor: '#008c8c'
          }
        }
      ],
      
      // 路径规划
      polyline: [],
      routeInfo: {
        distance: 0,
        duration: 0,
        mode: '步行'
      },
      
      // 地图控件
      controls: [
        {
          id: 1,
          iconPath: '/static/map/locate.png',
          position: {
            left: 10,
            top: 10,
            width: 40,
            height: 40
          },
          clickable: true
        }
      ],
      
      // 搜索
      searchKeyword: '',
      searchResults: [],
      showSearchResults: false,
      
      // 目的地设置
      showDestinationPanel: false,
      currentPosition: '',
      destination: '',
      destinationMarker: null,
      
      // 底部信息
      showBottomInfo: true
    }
  },
  
  computed: {
    mapTypeText() {
      return this.mapType === 0 ? '标准' : '卫星'
    }
  },
  
  onShow() {
    // 重置滑动位移
    if (this.translateX !== undefined) {
      this.translateX = 0;
    }
    // 同步tabBar选中状态
    this.syncTabBar();
    
    // 初始化地图
    this.initMap();
  },
  
  onHide() {
    // 清理定时器等资源
    if (this.mapContext) {
      this.mapContext = null;
    }
  },
  
  methods: {
    handleSwipe(diffX) {
      if (diffX > 0) { // 右滑（diffX为正）→ 左侧的设备页
        uni.switchTab({
          url: '/pages/device/device',
          success: () => {
            this.setTabBarActive(0)
          },
          fail: (err) => {
            console.warn('切换tab失败:', err)
          }
        })
      } else if (diffX < 0) { // 左滑（diffX为负）→ 右侧的我的页
        uni.switchTab({
          url: '/pages/profile/profile',
          success: () => {
            this.setTabBarActive(2)
          },
          fail: (err) => {
            console.warn('切换tab失败:', err)
          }
        })
      }
    },
    
    // 初始化地图
    initMap() {
      // 获取地图上下文
      this.mapContext = uni.createMapContext('myMap', this);
      
      // 获取用户位置
      this.getCurrentLocation();
      
      // 添加默认标记
      this.addDefaultMarkers();
    },
    
    // 获取当前位置
    getCurrentLocation() {
      uni.getLocation({
        type: 'gcj02',
        success: (res) => {
          this.latitude = res.latitude;
          this.longitude = res.longitude;
          this.currentPosition = `${res.latitude.toFixed(6)}, ${res.longitude.toFixed(6)}`;
          
          // 移动到当前位置
          this.mapContext.moveToLocation();
        },
        fail: (err) => {
          console.log('获取位置失败:', err);
          uni.showToast({
            title: '获取位置失败',
            icon: 'none'
          });
        }
      });
    },
    
    // 添加默认标记
    addDefaultMarkers() {
      // 这里可以添加更多默认标记
      // 例如园区关键点、设备位置等
    },
    
    // 标记点击事件
    onMarkerTap(e) {
      const markerId = e.markerId;
      const marker = this.markers.find(m => m.id === markerId);
      
      if (marker) {
        uni.showModal({
          title: marker.title || '位置信息',
          content: `经纬度: ${marker.latitude.toFixed(6)}, ${marker.longitude.toFixed(6)}`,
          showCancel: false,
          confirmText: '设为目的地'
        });
      }
    },
    
    // 控件点击事件
    onControlTap(e) {
      const controlId = e.controlId;
      
      if (controlId === 1) {
        // 定位按钮
        this.locateMe();
      }
    },
    
    // 区域变化事件
    onRegionChange(e) {
      if (e.type === 'end') {
        // 区域变化结束，可以获取新的中心点
        this.mapContext.getCenterLocation({
          success: (res) => {
            this.latitude = res.latitude;
            this.longitude = res.longitude;
          }
        });
      }
    },
    
    // 定位到我的位置
    locateMe() {
      this.getCurrentLocation();
      uni.showToast({
        title: '定位到当前位置',
        icon: 'success'
      });
    },
    
    // 切换地图类型
    toggleMapType() {
      this.mapType = this.mapType === 0 ? 1 : 0;
      uni.showToast({
        title: `切换到${this.mapTypeText}地图`,
        icon: 'none'
      });
    },
    
    // 放大
    zoomIn() {
      if (this.scale < 20) {
        this.scale += 1;
      }
    },
    
    // 缩小
    zoomOut() {
      if (this.scale > 3) {
        this.scale -= 1;
      }
    },
    
    // 搜索地点
    searchPlace() {
      if (!this.searchKeyword.trim()) {
        uni.showToast({
          title: '请输入搜索关键词',
          icon: 'none'
        });
        return;
      }
      
      uni.showLoading({
        title: '搜索中...'
      });
      
      // 这里应该调用高德地图搜索API
      // 由于小程序限制，可能需要通过云函数或自己的服务器代理
      this.searchWithAmap(this.searchKeyword);
    },
    
    // 使用高德地图搜索（需要服务器代理）
    async searchWithAmap(keyword) {
      try {
        // 这里需要实现服务器代理请求高德API
        // 因为小程序不能直接请求第三方API
        const response = await uni.request({
          url: `https://your-server.com/api/search?keyword=${encodeURIComponent(keyword)}&key=${AMAP_KEY}`,
          method: 'GET'
        });
        
        if (response.data.status === '1') {
          this.searchResults = response.data.pois;
          this.showSearchResults = true;
        } else {
          uni.showToast({
            title: '搜索失败',
            icon: 'none'
          });
        }
      } catch (error) {
        console.error('搜索出错:', error);
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        });
      } finally {
        uni.hideLoading();
      }
    },
    
    // 搜索框聚焦
    onSearchFocus() {
      this.showSearchResults = true;
    },
    
    // 搜索框失焦
    onSearchBlur() {
      setTimeout(() => {
        this.showSearchResults = false;
      }, 200);
    },
    
    // 打开目的地面板
    openDestinationPanel() {
      this.showDestinationPanel = true;
    },
    
    // 关闭目的地面板
    closeDestinationPanel() {
      this.showDestinationPanel = false;
    },
    
    // 在地图上选择
    selectOnMap() {
      uni.showToast({
        title: '请点击地图上的位置',
        icon: 'none'
      });
      
      // 这里可以设置一个临时监听，用户点击地图时获取位置
      // 由于小程序地图组件限制，可能需要其他方式实现
    },
    
    // 确认目的地
    confirmDestination() {
      if (this.destination.trim()) {
        // 解析地址或坐标
        this.parseDestination(this.destination);
      }
    },
    
    // 解析目的地
    parseDestination(input) {
      // 判断是坐标还是地址
      const coordPattern = /^[-+]?([1-8]?\d(\.\d+)?|90(\.0+)?),\s*[-+]?(180(\.0+)?|((1[0-7]\d)|([1-9]?\d))(\.\d+)?)$/;
      
      if (coordPattern.test(input)) {
        // 是坐标
        const [lat, lng] = input.split(',').map(Number);
        this.addDestinationMarker(lat, lng);
      } else {
        // 是地址，需要地理编码
        this.geocodeAddress(input);
      }
    },
    
    // 添加目的地标记
    addDestinationMarker(latitude, longitude) {
      // 移除旧的目的地标记
      this.markers = this.markers.filter(m => m.id !== 999);
      
      // 添加新的目的地标记
      this.markers.push({
        id: 999,
        latitude: latitude,
        longitude: longitude,
        title: '目的地',
        iconPath: '/static/map/destination.png',
        width: 40,
        height: 40
      });
      
      this.destinationMarker = {
        latitude,
        longitude
      };
      
      uni.showToast({
        title: '已设置目的地',
        icon: 'success'
      });
    },
    
    // 地址地理编码（需要服务器代理）
    async geocodeAddress(address) {
      uni.showLoading({
        title: '解析地址中...'
      });
      
      try {
        const response = await uni.request({
          url: `https://your-server.com/api/geocode?address=${encodeURIComponent(address)}&key=${AMAP_KEY}`,
          method: 'GET'
        });
        
        if (response.data.status === '1' && response.data.geocodes.length > 0) {
          const location = response.data.geocodes[0].location;
          const [lng, lat] = location.split(',').map(Number);
          
          this.addDestinationMarker(lat, lng);
          this.destination = `${lat.toFixed(6)}, ${lng.toFixed(6)}`;
        } else {
          uni.showToast({
            title: '地址解析失败',
            icon: 'none'
          });
        }
      } catch (error) {
        console.error('地址解析出错:', error);
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        });
      } finally {
        uni.hideLoading();
      }
    },
    
    // 规划路线
    async planRoute() {
      if (!this.currentPosition || !this.destinationMarker) {
        uni.showToast({
          title: '请先设置起点和目的地',
          icon: 'none'
        });
        return;
      }
      
      uni.showLoading({
        title: '路线规划中...'
      });
      
      try {
        // 调用高德地图路线规划API（需要服务器代理）
        const origin = this.currentPosition.split(',').map(Number).reverse().join(',');
        const destination = `${this.destinationMarker.longitude},${this.destinationMarker.latitude}`;
        
        const response = await uni.request({
          url: `https://your-server.com/api/direction/walking?origin=${origin}&destination=${destination}&key=${AMAP_KEY}`,
          method: 'GET'
        });
        
        if (response.data.status === '1' && response.data.route.paths.length > 0) {
          const path = response.data.route.paths[0];
          
          // 更新路线信息
          this.routeInfo = {
            distance: (path.distance / 1000).toFixed(2),
            duration: Math.ceil(path.duration / 60),
            mode: '步行'
          };
          
          // 绘制路线
          this.drawRoute(path.steps);
          
          uni.showToast({
            title: '路线规划成功',
            icon: 'success'
          });
        } else {
          uni.showToast({
            title: '路线规划失败',
            icon: 'none'
          });
        }
      } catch (error) {
        console.error('路线规划出错:', error);
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        });
      } finally {
        uni.hideLoading();
      }
    },
    
    // 绘制路线
    drawRoute(steps) {
      const points = [];
      
      steps.forEach(step => {
        const polyline = step.polyline.split(';');
        polyline.forEach(point => {
          const [lng, lat] = point.split(',').map(Number);
          points.push({
            latitude: lat,
            longitude: lng
          });
        });
      });
      
      this.polyline = [{
        points: points,
        color: '#008c8c',
        width: 6,
        dottedLine: false
      }];
    },
    
    // 发送到设备
    sendToDevice() {
      if (!this.routeInfo.distance) {
        uni.showToast({
          title: '请先规划路线',
          icon: 'none'
        });
        return;
      }
      
      uni.showModal({
        title: '发送目的地',
        content: `将目的地(${this.destinationMarker.latitude.toFixed(6)}, ${this.destinationMarker.longitude.toFixed(6)})发送到巡检机器人？`,
        success: (res) => {
          if (res.confirm) {
            this.sendDestinationToRobot();
          }
        }
      });
    },
    
    // 发送目的地到机器人（需要后端API）
    async sendDestinationToRobot() {
      uni.showLoading({
        title: '发送中...'
      });
      
      try {
        const response = await uni.request({
          url: 'https://your-server.com/api/robot/destination',
          method: 'POST',
          data: {
            longitude: this.destinationMarker.longitude,
            latitude: this.destinationMarker.latitude,
            distance: this.routeInfo.distance,
            duration: this.routeInfo.duration
          }
        });
        
        if (response.data.success) {
          uni.showToast({
            title: '目的地已发送',
            icon: 'success'
          });
        } else {
          uni.showToast({
            title: '发送失败',
            icon: 'none'
          });
        }
      } catch (error) {
        console.error('发送目的地出错:', error);
        uni.showToast({
          title: '网络错误',
          icon: 'none'
        });
      } finally {
        uni.hideLoading();
      }
    },
    
    // 清除路线
    clearRoute() {
      this.polyline = [];
      this.routeInfo = {
        distance: 0,
        duration: 0,
        mode: '步行'
      };
      
      // 移除目的地标记
      this.markers = this.markers.filter(m => m.id !== 999);
      this.destinationMarker = null;
      this.destination = '';
      
      uni.showToast({
        title: '已清除路线',
        icon: 'success'
      });
    },
    
    // 切换底部信息显示
    toggleBottomInfo() {
      this.showBottomInfo = !this.showBottomInfo;
    }
  }
}
</script>

<style scoped>
.page {
  width: 100%;
  height: 100vh;
  overflow: hidden;
}

/* 地图容器 */
.map-container {
  width: 100%;
  height: 100vh;
  position: relative;
}

.map {
  width: 100%;
  height: 100%;
}

/* 地图控制按钮 */
.map-controls {
  position: absolute;
  top: 80rpx;
  right: 20rpx;
  z-index: 100;
  display: flex;
  flex-direction: column;
  gap: 15rpx;
}

.control-btn {
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid #e0e0e0;
  border-radius: 25rpx;
  padding: 15rpx 20rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 80rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
}

.control-btn:active {
  background: rgba(240, 240, 240, 0.95);
  transform: scale(0.95);
}

.control-btn .icon {
  font-size: 32rpx;
  margin-bottom: 5rpx;
}

.control-btn .text {
  font-size: 20rpx;
  color: #333;
}

/* 搜索框 */
.search-container {
  position: absolute;
  top: 80rpx;
  left: 20rpx;
  right: 120rpx;
  z-index: 100;
  display: flex;
  gap: 10rpx;
}

.search-input {
  flex: 1;
  background: rgba(255, 255, 255, 0.95);
  border: 1rpx solid #e0e0e0;
  border-radius: 25rpx;
  padding: 20rpx 30rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.1);
  backdrop-filter: blur(10rpx);
}

.search-btn {
  background: #008c8c;
  border-radius: 25rpx;
  padding: 20rpx 25rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0, 140, 140, 0.3);
}

.search-btn:active {
  background: #007a7a;
  transform: scale(0.95);
}

.search-icon {
  font-size: 32rpx;
  color: white;
}

/* 目的地面板 */
.destination-panel {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: rgba(255, 255, 255, 0.98);
  border-top-left-radius: 30rpx;
  border-top-right-radius: 30rpx;
