<template>
    <view class="container">
        <!-- 顶部轮播图 -->
        <view class="swiper-container">
            <swiper class="swiper" indicator-dots="true" autoplay="true" interval="3000" duration="500">
                <swiper-item>
                    <image class="swiper-image" src="/static/1.jpg" mode="aspectFill"></image>
                </swiper-item>
                <swiper-item>
                    <image class="swiper-image" src="/static/2.jpg" mode="aspectFill"></image>
                </swiper-item>
                <swiper-item>
                    <image class="swiper-image" src="/static/3.jpg" mode="aspectFill"></image>
                </swiper-item>
            </swiper>
        </view>

        <!-- 系统标题 -->
        <view class="header">
            <text class="title">巡检机器人管理系统</text>
        </view>

        <!-- 登录表单 -->
        <view class="login-form">
            <view class="form-title">
                <text class="title-text">用户登录</text>
            </view>
            
            <!-- 用户名输入 -->
            <view class="input-group">
                <view class="input-label">
                    <text>用户名</text>
                </view>
                <view class="input-container">
                    <input 
                        class="input" 
                        type="text" 
                        placeholder="请输入用户名"
                        v-model="username"
                        placeholder-class="placeholder"
                    />
                </view>
            </view>

            <!-- 密码输入 -->
            <view class="input-group">
                <view class="input-label">
                    <text>密码</text>
                </view>
                <view class="input-container">
                    <input 
                        class="input" 
                        type="password" 
                        placeholder="请输入密码"
                        v-model="password"
                        placeholder-class="placeholder"
                    />
                </view>
            </view>

            <!-- 验证码输入 -->
            <view class="input-group">
                <view class="input-label">
                    <text>验证码</text>
                </view>
                <view class="captcha-container">
                    <view class="input-container captcha-input">
                        <input 
                            class="input" 
                            type="text" 
                            placeholder="请输入验证码"
                            v-model="captcha"
                            placeholder-class="placeholder"
                            maxlength="4"
                        />
                    </view>
                    <view class="captcha-img" @click="refreshCaptcha">
                        <image 
                            v-if="captchaUrl" 
                            :src="captchaUrl" 
                            mode="aspectFit"
                            class="captcha-image"
                            @error="onCaptchaError"
                        ></image>
                        <text v-else class="captcha-loading">加载中...</text>
                    </view>
                </view>
            </view>

            <!-- 记住密码和忘记密码 -->
            <view class="form-options">
                <view class="remember-me" @click="toggleRemember">
                    <view class="checkbox" :class="{checked: rememberPassword}">
                        <text class="checkmark" v-if="rememberPassword">✓</text>
                    </view>
                    <text class="option-text">记住密码</text>
                </view>
                <view class="forgot-password" @click="forgotPassword">
                    <text class="option-text link">忘记密码？</text>
                </view>
            </view>

            <!-- 登录按钮 -->
            <view class="login-button" @click="handleLogin">
                <text class="login-button-text">登录</text>
            </view>

            <!-- 注册链接 -->
            <view class="register-link">
                <text class="register-text">还没有账号？</text>
                <text class="link" @click="goToRegister">立即注册</text>
            </view>
        </view>

        <!-- 底部版权信息 -->
        <view class="footer">
            <text class="copyright">©2025 李文卓物联2431 版权所有</text>
            <view class="about-link" @click="goToAbout">
                <text class="link">关于我们</text>
            </view>
        </view>
    </view>
</template>

<script>
export default {
    data() {
        return {
            username: '',
            password: '',
            captcha: '',
            rememberPassword: false,
            captchaUrl: '',
            baseUrl: 'http://10.223.113.245:8080'
        }
    },
    onLoad() {
        // 初始化验证码
        this.refreshCaptcha();
        
        // 检查是否有保存的用户名
        const savedUsername = uni.getStorageSync('currentUsername');
        if (savedUsername) {
            this.username = savedUsername;
        }
        
        // 检查自动登录
        this.checkAutoLogin();
    },
    methods: {
        // 简化的自动登录逻辑
        checkAutoLogin() {
            try {
                const username = uni.getStorageSync('currentUsername');
                const userId = uni.getStorageSync('userId');
                const loginTime = uni.getStorageSync('loginTime');
                
                console.log('检查自动登录信息:', { username, userId, loginTime });
                
                // 只需要用户名和用户ID
                if (username && userId) {
                    const now = new Date().getTime();
                    const oneDay = 1 * 24 * 60 * 60 * 1000;
                    
                    // 检查登录时间（可选）
                    if (loginTime && now - loginTime < oneDay) {
                        console.log('自动跳转到主界面');
                        
                        uni.showLoading({
                            title: '自动登录中...',
                            mask: true
                        });
                        
                        setTimeout(() => {
                            uni.hideLoading();
                            uni.switchTab({
                                url: '/pages/device/device'
                            });
                        }, 1000);
                    }
                }
            } catch (error) {
                console.error('检查自动登录失败:', error);
            }
        },
        
        // 切换记住密码状态
        toggleRemember() {
            this.rememberPassword = !this.rememberPassword;
        },
        
        // 刷新验证码
        refreshCaptcha() {
            try {
                const timestamp = new Date().getTime();
                this.captchaUrl = `${this.baseUrl}/api/auth/captcha?t=${timestamp}`;
            } catch (error) {
                console.error('刷新验证码失败:', error);
                uni.showToast({
                    title: '验证码加载失败',
                    icon: 'none'
                });
            }
        },
        
        // 验证码加载错误处理
        onCaptchaError() {
            console.error('验证码图片加载失败');
            this.captchaUrl = '';
        },
        
        // 处理登录
        async handleLogin() {
            // 表单验证
            if (!this.username.trim()) {
                uni.showToast({ title: '请输入用户名', icon: 'none' });
                return;
            }
            
            if (!this.password) {
                uni.showToast({ title: '请输入密码', icon: 'none' });
                return;
            }
            
            if (!this.captcha.trim()) {
                uni.showToast({ title: '请输入验证码', icon: 'none' });
                return;
            }
            
            uni.showLoading({ title: '登录中...', mask: true });
            
            try {
                const response = await uni.request({
                    url: `${this.baseUrl}/api/auth/login`,
                    method: 'POST',
                    data: `username=${encodeURIComponent(this.username.trim())}&password=${encodeURIComponent(this.password)}&captcha=${encodeURIComponent(this.captcha.trim())}`,
                    header: { 'Content-Type': 'application/x-www-form-urlencoded' },
                    timeout: 10000
                });
                
                uni.hideLoading();
                
                if (response.statusCode === 200) {
                    const result = response.data;
                    
                    if (result.success) {
                        console.log('登录成功:', result);
                        
                        // 简化存储：只存用户名和用户ID
                        uni.setStorageSync('currentUsername', this.username);
                        const userId = result.userId || (result.data && result.data.userId) || '';
                        uni.setStorageSync('userId', userId.toString());
                        uni.setStorageSync('loginTime', new Date().getTime());
                        
                        uni.showToast({
                            title: '登录成功！',
                            icon: 'success',
                            duration: 1500
                        });
                        
                        setTimeout(() => {
                            uni.switchTab({ url: '/pages/device/device' });
                        }, 1500);
                        
                    } else {
                        uni.showToast({
                            title: result.message || '登录失败',
                            icon: 'none'
                        });
                        
                        this.refreshCaptcha();
                        this.captcha = '';
                    }
                } else {
                    uni.showToast({
                        title: response.data?.message || `服务器错误: ${response.statusCode}`,
                        icon: 'none',
                        duration: 3000
                    });
                }
                
            } catch (error) {
                uni.hideLoading();
                console.error('登录请求失败:', error);
                
                let errorMessage = '登录失败，请重试';
                if (error.errMsg?.includes('timeout')) errorMessage = '请求超时';
                if (error.errMsg?.includes('fail')) errorMessage = '无法连接到服务器';
                
                uni.showToast({ title: errorMessage, icon: 'none', duration: 3000 });
                this.refreshCaptcha();
                this.captcha = '';
            }
        },
        
        // 忘记密码
        forgotPassword() {
            uni.showModal({
                title: '忘记密码',
                content: '请联系系统管理员重置密码',
                showCancel: false,
                confirmText: '知道了'
            });
        },
        
        // 跳转到关于我们页面
        goToAbout() {
            uni.navigateTo({ url: '/pages/about/about' });
        },
        
        // 跳转到注册页面
        goToRegister() {
            uni.navigateTo({ url: '/pages/register/register' });
        }
    }
}
</script>

