    flex: 1;
}

.captcha-img {
    width: 200rpx;
    height: 80rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    background: #f8f9fa;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}

