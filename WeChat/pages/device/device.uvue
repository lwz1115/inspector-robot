<template>
  <view class="page" 
        :style="{ transform: `translateX(${translateX}px)`, transition: 'transform 0.1s ease' }"
        @touchstart="onTouchStart" 
        @touchmove="onTouchMove" 
        @touchend="onTouchEnd">
    <!-- 只保留滑动效果，原内容不变 -->
    <text>设备页面</text>
  </view>
</template>

<script>
import tabSwipe from '@/mixins/tabSwipe.js'

export default {
  mixins: [tabSwipe],
  data() {
    return {
      pagePath: '/pages/device/device'
    }
  },
  onShow() {
    // 重置滑动位移
    if (this.translateX !== undefined) {
      this.translateX = 0;
    }
    // 同步tabBar选中状态
    this.syncTabBar();
  },
  methods: {
    handleSwipe(diffX) {
      // 设备页是第一个，只能左滑（向右切换到导航页），右滑无操作
      if (diffX < 0) { // 左滑（diffX为负）→ 导航页
        uni.switchTab({
          url: '/pages/navigation/navigation',
          success: () => {
            this.setTabBarActive(1)
          },
          fail: (err) => {
            console.warn('切换tab失败:', err)
          }
        })
      }
      // 右滑（diffX>0）无操作，因为是第一个页面
    }
  }
}
</script>

<style scoped>
.page {
  width: 100%;
  height: 100vh;
  display: flex;
  justify-content: center;
  align-items: center;
  font-size: 32rpx;
  /* 必须添加这个才能滑动 */
  overflow: hidden;
}
</style>