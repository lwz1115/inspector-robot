<template>
  <view class="page" :style="'background:' + theme.bg + ';min-height:100vh;'">
    <view class="header" :style="theme.headerBg.startsWith('linear') ? 'background:' + theme.headerBg : 'background:' + theme.primary">
      <text class="header-title">设备监控</text>
      <view class="refresh-btn" @click="fetchData">
        <text class="refresh-icon">{{ loading ? '⏳' : '🔄' }}</text>
      </view>
    </view>

    <!-- 连接状态 -->
    <view class="status-bar" :class="connected ? 'connected' : 'disconnected'">
      <text class="status-dot">●</text>
      <text class="status-text">{{ connected ? '已连接' : '未连接' }}</text>
      <text class="status-time" v-if="lastUpdate">更新: {{ lastUpdate }}</text>
    </view>

    <!-- 数据卡片区 -->
    <scroll-view class="scroll-area" scroll-y>
      <!-- 位置信息 -->
      <view class="card" :style="'background:' + theme.card + ';border:1rpx solid ' + theme.border + ';'">
        <view class="card-header" :style="'background:' + theme.inputBg + ';border-bottom:1rpx solid ' + theme.border + ';'">
          <text class="card-icon">📍</text>
          <text class="card-title" :style="valueStyle">位置信息</text>
        </view>
        <view class="card-body">
          <view class="data-row">
            <text class="data-label" :style="labelStyle">纬度</text>
            <text class="data-value" :style="valueStyle">{{ robotData.latitude || '--' }}</text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">经度</text>
            <text class="data-value" :style="valueStyle">{{ robotData.longitude || '--' }}</text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">海拔</text>
            <text class="data-value" :style="valueStyle">{{ robotData.altitude != null ? robotData.altitude + ' m' : '--' }}</text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">速度</text>
            <text class="data-value" :style="valueStyle">{{ robotData.speed != null ? robotData.speed + ' km/h' : '--' }}</text>
          </view>
        </view>
      </view>

      <!-- IMU姿态 -->
      <view class="card">
        <view class="card-header">
          <text class="card-icon">🧭</text>
          <text class="card-title" :style="valueStyle">IMU姿态</text>
        </view>
        <view class="card-body">
          <view class="data-row">
            <text class="data-label" :style="labelStyle">Roll（横滚）</text>
            <text class="data-value" :style="valueStyle">{{ formatAngle(robotData.roll) }}</text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">Pitch（俯仰）</text>
            <text class="data-value" :style="valueStyle">{{ formatAngle(robotData.pitch) }}</text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">Yaw（偏航）</text>
            <text class="data-value" :style="valueStyle">{{ formatAngle(robotData.yaw) }}</text>
          </view>
        </view>
      </view>

      <!-- 激光雷达 -->
      <view class="card">
        <view class="card-header">
          <text class="card-icon">📡</text>
          <text class="card-title" :style="valueStyle">激光雷达</text>
        </view>
        <view class="card-body">
          <view class="data-row">
            <text class="data-label" :style="labelStyle">状态</text>
            <text class="data-value" :class="robotData.lidarOnline ? 'online' : 'offline'">
              {{ robotData.lidarOnline ? '在线' : '离线' }}
            </text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">最近距离</text>
            <text class="data-value" :style="valueStyle">{{ robotData.lidarMinDist != null ? robotData.lidarMinDist + ' m' : '--' }}</text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">点云数量</text>
            <text class="data-value" :style="valueStyle">{{ robotData.lidarPoints != null ? robotData.lidarPoints : '--' }}</text>
          </view>
        </view>
      </view>

      <!-- 摄像头 -->
      <view class="card">
        <view class="card-header">
          <text class="card-icon">📷</text>
          <text class="card-title" :style="valueStyle">摄像头</text>
        </view>
        <view class="card-body">
          <view class="data-row">
            <text class="data-label" :style="labelStyle">状态</text>
            <text class="data-value" :class="robotData.cameraOnline ? 'online' : 'offline'">
              {{ robotData.cameraOnline ? '在线' : '离线' }}
            </text>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">分辨率</text>
            <text class="data-value" :style="valueStyle">{{ robotData.cameraResolution || '--' }}</text>
          </view>
        </view>
      </view>

      <!-- 系统状态 -->
      <view class="card">
        <view class="card-header">
          <text class="card-icon">💻</text>
          <text class="card-title" :style="valueStyle">系统状态</text>
        </view>
        <view class="card-body">
          <view class="data-row">
            <text class="data-label" :style="labelStyle">CPU使用率</text>
            <view class="progress-wrap">
              <view class="progress-bar">
                <view class="progress-fill" :style="{ width: cpuPercent + '%', background: cpuColor }"></view>
              </view>
              <text class="progress-text">{{ robotData.cpuUsage != null ? robotData.cpuUsage + '%' : '--' }}</text>
            </view>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">内存使用率</text>
            <view class="progress-wrap">
              <view class="progress-bar">
                <view class="progress-fill" :style="{ width: memPercent + '%', background: memColor }"></view>
              </view>
              <text class="progress-text">{{ robotData.memUsage != null ? robotData.memUsage + '%' : '--' }}</text>
            </view>
          </view>
          <view class="data-row">
            <text class="data-label" :style="labelStyle">运行时长</text>
            <text class="data-value" :style="valueStyle">{{ robotData.uptime || '--' }}</text>
          </view>
        </view>
      </view>

      <!-- 底部间距 -->
      <view style="height: 40rpx;"></view>
    </scroll-view>
  </view>
</template>

<script>
import { BASE } from '@/config/server.js'
import { getThemeVars } from '@/config/theme.js'

const POLL_INTERVAL = 3000

export default {
  data() {
    return {
      loading: false,
      connected: false,
      lastUpdate: '',
      pollTimer: null,
      robotData: {},
      theme: getThemeVars()
    }
  },

  computed: {
    cardStyle()  { return 'background:' + this.theme.card + ';border:1rpx solid ' + this.theme.border + ';' },
    cardHdStyle(){ return 'background:' + this.theme.inputBg + ';border-bottom:1rpx solid ' + this.theme.border + ';' },
    labelStyle() { return 'color:' + this.theme.textSub + ';' },
    valueStyle() { return 'color:' + this.theme.text + ';' },
    cpuPercent() {
      const v = parseFloat(this.robotData.cpuUsage)
      return isNaN(v) ? 0 : Math.min(v, 100)
    },
    memPercent() {
      const v = parseFloat(this.robotData.memUsage)
      return isNaN(v) ? 0 : Math.min(v, 100)
    },
    cpuColor() {
      return this.cpuPercent > 80 ? '#f5222d' : this.cpuPercent > 60 ? '#fa8c16' : '#52c41a'
    },
    memColor() {
      return this.memPercent > 80 ? '#f5222d' : this.memPercent > 60 ? '#fa8c16' : '#52c41a'
    }
  },

  onShow() {
    this.theme = getThemeVars()
    this.fetchData()
    this.startPolling()
  },

  onHide() {
    this.stopPolling()
  },

  onUnload() {
    this.stopPolling()
  },

  methods: {
    startPolling() {
      this.stopPolling()
      this.pollTimer = setInterval(() => { this.fetchData() }, POLL_INTERVAL)
    },

    stopPolling() {
      if (this.pollTimer) {
        clearInterval(this.pollTimer)
        this.pollTimer = null
      }
    },

    async fetchData() {
      if (this.loading) return
      this.loading = true
      try {
        const res = await uni.request({
          url: BASE + '/robot-data',
          method: 'GET',
          timeout: 5000
        })
        if (res.statusCode === 200 && res.data) {
          this.robotData = res.data
          this.connected = true
          const now = new Date()
          this.lastUpdate = now.getHours() + ':' +
            String(now.getMinutes()).padStart(2, '0') + ':' +
            String(now.getSeconds()).padStart(2, '0')
        } else {
          this.connected = false
        }
      } catch (e) {
        this.connected = false
      } finally {
        this.loading = false
      }
    },

    formatAngle(val) {
      if (val == null || val === '') return '--'
      return parseFloat(val).toFixed(2) + '°'
    }
  }
}
</script>

<style scoped>
.page {
  flex: 1;
  background: #f5f5f5;
  min-height: 100vh;
}

/* 顶部标题 */
.header {
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  background: #1890ff;
  padding: 50rpx 30rpx 30rpx;
}

