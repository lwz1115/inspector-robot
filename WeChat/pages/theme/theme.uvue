<template>
  <view class="page" :style="'background:' + theme.bg + ';min-height:100vh;'">
    <!-- 导航栏 -->
    <view class="nav-bar" :style="'background:' + theme.card + ';border-bottom:1rpx solid ' + theme.border + ';'">
      <view class="nav-back" @click="goBack">
        <text class="nav-back-icon" :style="'color:' + theme.primary + ';'">‹</text>
      </view>
      <text class="nav-title" :style="'color:' + theme.text + ';'">主题设置</text>
      <view class="nav-placeholder"></view>
    </view>

    <!-- 当前主题横幅 -->
    <view class="current-banner" :style="theme.headerBg.startsWith('linear') ? 'background:' + theme.headerBg : 'background:' + theme.primary">
      <view class="banner-inner">
        <view class="banner-icon-wrap">
          <text class="banner-icon">🎨</text>
        </view>
        <view class="banner-info">
          <text class="banner-label">当前主题</text>
          <text class="banner-name">{{ theme.name }}</text>
        </view>
        <view class="banner-check">
          <text class="banner-check-icon">✓</text>
        </view>
      </view>
    </view>

    <!-- 主题列表 -->
    <scroll-view scroll-y class="theme-scroll">
      <view class="theme-list">
        <view v-for="t in themeList" :key="t.id"
          class="theme-card"
          :style="'background:' + t.card + ';border:3rpx solid ' + (currentId === t.id ? t.primary : t.border) + ';' + (currentId === t.id ? 'box-shadow:0 4rpx 24rpx ' + t.primary + '44;' : 'box-shadow:0 4rpx 16rpx rgba(0,0,0,0.07);')"
          @click="previewTheme(t)"
        >
          <!-- 手机预览 -->
          <view class="preview-wrap">
            <view class="phone-frame" :style="'border-color:' + t.border + ';'">
              <view class="phone-status" :style="'background:' + t.primary + ';'"></view>
              <view class="phone-header" :style="t.headerBg.startsWith('linear') ? 'background:' + t.headerBg : 'background:' + t.primary">
                <view class="ph-avatar" :style="'background:rgba(255,255,255,0.35);'"></view>
                <view class="ph-lines">
                  <view class="ph-line ph-line-w" :style="'background:rgba(255,255,255,0.9);'"></view>
                  <view class="ph-line ph-line-s" :style="'background:rgba(255,255,255,0.55);'"></view>
                </view>
              </view>
              <view class="phone-body" :style="'background:' + t.bg + ';'">
                <view class="pb-card" :style="'background:' + t.card + ';border-color:' + t.border + ';'">
                  <view class="pb-row" v-for="i in 3" :key="i">
                    <view class="pb-dot" :style="'background:' + t.primary + ';'"></view>
                    <view class="pb-bar" :style="'background:' + t.border + ';'"></view>
                    <text class="pb-arrow" :style="'color:' + t.textSub + ';'">›</text>
                  </view>
                </view>
                <view class="pb-btn" :style="'background:' + t.primary + ';'"></view>
              </view>
              <view class="phone-tab" :style="'background:' + t.card + ';border-color:' + t.border + ';'">
                <view class="pt-item" v-for="j in 3" :key="j">
                  <view class="pt-dot" :style="'background:' + (j === 2 ? t.primary : t.border) + ';'"></view>
                </view>
              </view>
            </view>
          </view>

          <!-- 主题信息 -->
          <view class="theme-info">
            <view class="theme-name-row">
              <text class="theme-name" :style="'color:' + t.text + ';'">{{ t.name }}</text>
              <view v-if="currentId === t.id" class="active-badge" :style="'background:' + t.primary + ';'">
                <text class="active-badge-text">使用中</text>
              </view>
            </view>
            <text class="theme-desc" :style="'color:' + t.textSub + ';'">{{ t.desc }}</text>
            <view class="color-swatches">
              <view class="swatch" v-for="(c, ci) in t.swatches" :key="ci" :style="'background:' + c + ';'"></view>
            </view>
            <view class="apply-btn"
              :style="'background:' + t.primary + ';opacity:' + (currentId === t.id ? '0.5' : '1') + ';'"
              @click.stop="applyTheme(t)">
              <text class="apply-btn-text">{{ currentId === t.id ? '已应用' : '应用主题' }}</text>
            </view>
          </view>
        </view>
      </view>
    </scroll-view>
  </view>
</template>

<script>
import { THEMES, getThemeVars } from '@/config/theme.js'

const DESCS = {
  classic:  '沉稳清爽的默认风格，青绿主色调，适合日常使用',
  midnight: '深色背景配霓虹紫蓝，科技感十足，护眼夜间模式',
  sakura:   '粉白渐变，温柔细腻，清新少女风格'
}
const SWATCHES = {
  classic:  ['#008c8c', '#00a8a8', '#f1f1f1', '#ffffff'],
  midnight: ['#0d1117', '#161b22', '#7c3aed', '#a78bfa'],
  sakura:   ['#fff0f6', '#ffffff', '#ec4899', '#f472b6']
}

export default {
  data() {
    return {
      currentId: 'classic',
      theme: getThemeVars(),
      themeList: Object.values(THEMES).map(t => ({
        ...t,
        desc: DESCS[t.id] || '',
        swatches: SWATCHES[t.id] || []
      }))
    }
  },

  onLoad() {
    try {
      this.currentId = uni.getStorageSync('appTheme') || 'classic'
    } catch (e) {}
    this.theme = getThemeVars()
  },

  onShow() {
    try {
      this.currentId = uni.getStorageSync('appTheme') || 'classic'
    } catch (e) {}
    this.theme = getThemeVars()
  },

  methods: {
    goBack() { uni.navigateBack() },

    previewTheme(t) {
      this.currentId = t.id
      this.theme = t
    },

    applyTheme(t) {
      this.currentId = t.id
      this.theme = t
      try {
        uni.setStorageSync('appTheme', t.id)
      } catch (e) {}
      uni.showToast({ title: '主题已应用', icon: 'success', duration: 1500 })
    }
  }
}
</script>

<style scoped>
.page { min-height: 100vh; }

.nav-bar {
  flex-direction: row; align-items: center; justify-content: space-between;
  padding: 88rpx 30rpx 24rpx; position: sticky; top: 0; z-index: 100;
}
.nav-back { width: 60rpx; height: 60rpx; align-items: center; justify-content: center; }
.nav-back-icon { font-size: 60rpx; font-weight: 300; line-height: 1; }
.nav-title { font-size: 32rpx; font-weight: bold; }
.nav-placeholder { width: 60rpx; }

.current-banner {
  margin: 0 30rpx 30rpx; border-radius: 20rpx;
  padding: 28rpx 30rpx; box-shadow: 0 6rpx 24rpx rgba(0,0,0,0.15);
}
.banner-inner { flex-direction: row; align-items: center; }
.banner-icon-wrap {
  width: 72rpx; height: 72rpx; border-radius: 18rpx;
  background: rgba(255,255,255,0.2);
  align-items: center; justify-content: center; margin-right: 24rpx;
}
.banner-icon { font-size: 36rpx; }
.banner-info { flex: 1; }
.banner-label { font-size: 22rpx; color: rgba(255,255,255,0.75); margin-bottom: 6rpx; }
.banner-name { font-size: 30rpx; font-weight: bold; color: #ffffff; }
.banner-check {
  width: 48rpx; height: 48rpx; border-radius: 50%;
  background: rgba(255,255,255,0.25);
  align-items: center; justify-content: center;
}
.banner-check-icon { font-size: 26rpx; color: #ffffff; font-weight: bold; }

.theme-scroll { flex: 1; }
.theme-list { padding: 0 30rpx 60rpx; }

.theme-card {
  border-radius: 24rpx; margin-bottom: 30rpx;
  overflow: hidden; flex-direction: row;
}

.preview-wrap {
  width: 200rpx; padding: 24rpx 0 24rpx 24rpx;
  align-items: center; justify-content: center;
}
.phone-frame {
  width: 140rpx; height: 240rpx; border-radius: 18rpx;
  overflow: hidden; border: 3rpx solid;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.15); flex-direction: column;
}
.phone-status { height: 10rpx; }
.phone-header { height: 60rpx; flex-direction: row; align-items: center; padding: 0 10rpx; }
.ph-avatar { width: 28rpx; height: 28rpx; border-radius: 50%; margin-right: 8rpx; }
.ph-lines { flex: 1; }
.ph-line { height: 6rpx; border-radius: 3rpx; margin-bottom: 4rpx; }
.ph-line-w { width: 70%; }
.ph-line-s { width: 45%; }
.phone-body { flex: 1; padding: 8rpx; }
.pb-card { border-radius: 8rpx; border: 1rpx solid; padding: 6rpx 8rpx; margin-bottom: 6rpx; }
.pb-row { flex-direction: row; align-items: center; margin-bottom: 5rpx; }
.pb-dot { width: 8rpx; height: 8rpx; border-radius: 50%; margin-right: 6rpx; }
.pb-bar { flex: 1; height: 6rpx; border-radius: 3rpx; }
.pb-arrow { margin-left: 4rpx; font-size: 18rpx; }
.pb-btn { height: 16rpx; border-radius: 8rpx; margin-top: 4rpx; }
.phone-tab {
  height: 28rpx; flex-direction: row; align-items: center;
  justify-content: space-around; border-top: 1rpx solid;
}
.pt-item { align-items: center; }
.pt-dot { width: 10rpx; height: 10rpx; border-radius: 50%; }

.theme-info { flex: 1; padding: 24rpx 24rpx 24rpx 16rpx; }
.theme-name-row { flex-direction: row; align-items: center; margin-bottom: 10rpx; }
.theme-name { font-size: 30rpx; font-weight: bold; margin-right: 12rpx; }
.active-badge { border-radius: 10rpx; padding: 4rpx 12rpx; }
.active-badge-text { font-size: 18rpx; color: #ffffff; font-weight: bold; }
.theme-desc { font-size: 22rpx; line-height: 1.5; margin-bottom: 16rpx; }
.color-swatches { flex-direction: row; margin-bottom: 20rpx; }
.swatch { width: 28rpx; height: 28rpx; border-radius: 50%; margin-right: 10rpx; border: 2rpx solid rgba(0,0,0,0.08); }
.apply-btn { border-radius: 12rpx; padding: 14rpx 0; align-items: center; justify-content: center; }
.apply-btn-text { font-size: 24rpx; color: #ffffff; font-weight: bold; }
</style>
