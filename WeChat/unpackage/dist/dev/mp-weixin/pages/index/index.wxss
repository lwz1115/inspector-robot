@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container.data-v-00a60067 {
    flex: 1;
    background: #f5f5f5;
}

/* 轮播图容器 */
.swiper-container.data-v-00a60067 {
    height: 300rpx;
    width: 100%;
}
.swiper.data-v-00a60067 {
    height: 100%;
    width: 100%;
}
.swiper-image.data-v-00a60067 {
    height: 100%;
    width: 100%;
}

/* 系统标题 */
.header.data-v-00a60067 {
    padding: 40rpx 0 20rpx 0;
    align-items: center;
    background: #f5f5f5;
}
.title.data-v-00a60067 {
    font-size: 36rpx;
    font-weight: bold;
    color: #333333;
    text-align: center;
}

/* 登录表单 */
.login-form.data-v-00a60067 {
    margin: 0 40rpx;
    background: #ffffff;
    border-radius: 20rpx;
    padding: 50rpx 40rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
    margin-top: 20rpx;
}
.form-title.data-v-00a60067 {
    margin-bottom: 50rpx;
    align-items: center;
}
.title-text.data-v-00a60067 {
    font-size: 32rpx;
    font-weight: bold;
    color: #333333;
}

/* 输入框组 */
.input-group.data-v-00a60067 {
    margin-bottom: 40rpx;
}
.input-label.data-v-00a60067 {
    margin-bottom: 20rpx;
}
.input-label text.data-v-00a60067 {
    font-size: 28rpx;
    color: #333333;
    font-weight: 500;
}
.input-container.data-v-00a60067 {
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    padding: 24rpx;
    background: #f8f9fa;
}
.input.data-v-00a60067 {
    font-size: 28rpx;
    color: #333333;
}
.placeholder.data-v-00a60067 {
    color: #999999;
    font-size: 28rpx;
}

/* 验证码容器 */
.captcha-container.data-v-00a60067 {
    flex-direction: row;
    align-items: center;
    gap: 20rpx;
}
.captcha-input.data-v-00a60067 {
    flex: 1;
}
.captcha-img.data-v-00a60067 {
    width: 200rpx;
    height: 80rpx;
    border: 2rpx solid #e0e0e0;
    border-radius: 12rpx;
    background: #f8f9fa;
    justify-content: center;
    align-items: center;
    overflow: hidden;
}
.captcha-image.data-v-00a60067 {
    width: 100%;
    height: 100%;
}
.captcha-loading.data-v-00a60067 {
    font-size: 24rpx;
    color: #999999;
}

/* 表单选项 */
.form-options.data-v-00a60067 {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 50rpx;
}
.remember-me.data-v-00a60067 {
    flex-direction: row;
    align-items: center;
}
.checkbox.data-v-00a60067 {
    width: 32rpx;
    height: 32rpx;
    border: 2rpx solid #cccccc;
    border-radius: 6rpx;
    margin-right: 16rpx;
    justify-content: center;
    align-items: center;
}
.checkbox.checked.data-v-00a60067 {
    background: #1890ff;
    border-color: #1890ff;
}
.checkmark.data-v-00a60067 {
    color: #ffffff;
    font-size: 24rpx;
    font-weight: bold;
}
.option-text.data-v-00a60067 {
    font-size: 26rpx;
    color: #666666;
}
.link.data-v-00a60067 {
    color: #1890ff;
}

/* 登录按钮 */
.login-button.data-v-00a60067 {
    background: #1890ff;
    border-radius: 12rpx;
    padding: 28rpx;
    align-items: center;
    justify-content: center;
    margin-bottom: 30rpx;
}
.login-button.data-v-00a60067:active {
    opacity: 0.9;
    background: #096dd9;
}
.login-button-text.data-v-00a60067 {
    font-size: 32rpx;
    font-weight: bold;
    color: #ffffff;
}

/* 注册链接 */
.register-link.data-v-00a60067 {
    flex-direction: row;
    justify-content: center;
    align-items: center;
    margin-top: 20rpx;
}
.register-text.data-v-00a60067 {
    font-size: 26rpx;
    color: #666666;
    margin-right: 10rpx;
}

/* 底部版权 */
.footer.data-v-00a60067 {
    margin-top: 60rpx;
    padding: 40rpx 0;
    align-items: center;
    background: #f5f5f5;
}
.copyright.data-v-00a60067 {
    font-size: 24rpx;
    color: #666666;
    margin-bottom: 20rpx;
}
.about-link.data-v-00a60067 {
    padding: 10rpx 20rpx;
}
.about-link .link.data-v-00a60067 {
    font-size: 24rpx;
    color: #1890ff;
}
