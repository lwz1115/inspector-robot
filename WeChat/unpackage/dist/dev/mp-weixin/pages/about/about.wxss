@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.container.data-v-fe428a0d {
    flex: 1;
    background: #f5f5f5;
}

/* 导航头部 */
.nav-header.data-v-fe428a0d {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    padding: 40rpx 30rpx 20rpx;
    background: white;
    border-bottom: 1rpx solid #f0f0f0;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
}
.nav-back.data-v-fe428a0d {
    flex-direction: row;
    align-items: center;
}
.back-text.data-v-fe428a0d {
    font-size: 48rpx;
    color: #1890ff;
    margin-right: 10rpx;
}
.back-label.data-v-fe428a0d {
    font-size: 28rpx;
    color: #1890ff;
}
.nav-title.data-v-fe428a0d {
    font-size: 36rpx;
    font-weight: bold;
    color: #333333;
}
.nav-placeholder.data-v-fe428a0d {
    width: 120rpx;
}

/* 内容区域 */
.content.data-v-fe428a0d {
    flex: 1;
    margin-top: 120rpx;
    height: calc(100vh - 120rpx);
}

/* 顶部图片 */
.image-section.data-v-fe428a0d {
    width: 100%;
    height: 400rpx;
}
.campus-image.data-v-fe428a0d {
    width: 100%;
    height: 100%;
}

/* 信息卡片 */
.info-card.data-v-fe428a0d {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx;
    margin: 30rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}
.school-name.data-v-fe428a0d {
    font-size: 36rpx;
    font-weight: bold;
    color: #333333;
    text-align: center;
    margin-bottom: 40rpx;
}

/* 联系方式列表 */
.contact-list.data-v-fe428a0d {
    margin-bottom: 40rpx;
}
.contact-item.data-v-fe428a0d {
    flex-direction: row;
    align-items: center;
    padding: 20rpx 0;
    border-bottom: 1rpx solid #f0f0f0;
}
.contact-item.data-v-fe428a0d:last-child {
    border-bottom: none;
}
.contact-icon.data-v-fe428a0d {
    font-size: 36rpx;
    margin-right: 20rpx;
    width: 50rpx;
    text-align: center;
}
.contact-info.data-v-fe428a0d {
    flex: 1;
}
.contact-label.data-v-fe428a0d {
    font-size: 28rpx;
    color: #666666;
    display: block;
    margin-bottom: 8rpx;
}
.contact-value.data-v-fe428a0d {
    font-size: 30rpx;
    color: #333333;
    font-weight: 500;
}

/* 简化的文本部分 */
.simple-text-section.data-v-fe428a0d {
    margin-top: 40rpx;
    padding-top: 40rpx;
    border-top: 1rpx solid #f0f0f0;
}
.simple-text.data-v-fe428a0d {
    font-size: 28rpx;
    color: #666666;
    line-height: 1.6;
    text-align: center;
}

/* 地图卡片 */
.map-card.data-v-fe428a0d {
    background: white;
    border-radius: 20rpx;
    padding: 40rpx;
    margin: 0 30rpx 30rpx 30rpx;
    box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
}
.map-title.data-v-fe428a0d {
    font-size: 32rpx;
    font-weight: bold;
    color: #333333;
    margin-bottom: 30rpx;
    display: block;
}
.map-container.data-v-fe428a0d {
    position: relative;
    border-radius: 15rpx;
    overflow: hidden;
    margin-bottom: 20rpx;
}
.map.data-v-fe428a0d {
    width: 100%;
    height: 400rpx;
}
.map-overlay.data-v-fe428a0d {
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    background: linear-gradient(transparent, rgba(0,0,0,0.7));
    padding: 30rpx;
    align-items: center;
}
.map-address.data-v-fe428a0d {
    color: white;
    font-size: 28rpx;
    text-align: center;
}
.location-text.data-v-fe428a0d {
    font-size: 26rpx;
    color: #666666;
    text-align: center;
}

/* 底部信息 */
.bottom-info.data-v-fe428a0d {
    align-items: center;
    padding: 40rpx 30rpx;
    background: #f8f9fa;
}
.team-info.data-v-fe428a0d {
    font-size: 28rpx;
    color: #333333;
    margin-bottom: 15rpx;
    font-weight: 500;
}
.copyright.data-v-fe428a0d {
    font-size: 24rpx;
    color: #999999;
}
