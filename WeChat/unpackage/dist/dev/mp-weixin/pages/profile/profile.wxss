@import "../../uvue.wxss";
:host{display:flex;flex-direction:column}

.page.data-v-a67938aa {
  background-color: #f1f1f1;
  min-height: 100vh;
  position: relative;
  overflow-x: hidden;
}

/* 内容包装器 - 用于整体下拉 */
.content-wrapper.data-v-a67938aa {
  min-height: 100vh;
  padding-bottom: 40rpx; /* 添加底部内边距 */
}

/* 设置背景颜色 */
.top-bg.data-v-a67938aa {
  height: 320rpx; /* 恢复高度 */
  background: linear-gradient(135deg, #008c8c, #00a8a8);
  position: relative;
  overflow: hidden;
  padding-top: 80rpx; /* 增加上内边距 */
}

/* 头像部分 */
.head-box.data-v-a67938aa {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 10;
  padding-bottom: 30rpx;
}
.avatar-section.data-v-a67938aa {
  position: relative;
  cursor: pointer;
  margin-bottom: 20rpx;
}
.head-img.data-v-a67938aa {
  width: 140rpx; /* 恢复合适大小 */
  height: 140rpx;
  overflow: hidden;
  border-radius: 50%;
  border: 6rpx solid white;
  box-shadow: 0 6rpx 18rpx rgba(0, 0, 0, 0.15);
  background-color: white;
  transition: all 0.3s ease;
}

/* 点击头像效果 */
.avatar-section:active .head-img.data-v-a67938aa {
  transform: scale(0.95);
}

/* 用户信息区域 */
.user-info.data-v-a67938aa {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 10rpx;
}
.tip.data-v-a67938aa {
  font-size: 32rpx;
  color: white;
  font-weight: bold;
  text-align: center;
  line-height: 1.2;
  text-shadow: 0 1rpx 3rpx rgba(0, 0, 0, 0.2);
  padding: 0 30rpx;
}
.user-id.data-v-a67938aa {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.9);
  background: rgba(0, 0, 0, 0.15);
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  text-align: center;
}

/* 菜单卡片 - 整体下移，与头像保持距离 */
.box.data-v-a67938aa {
  background-color: white;
  margin: 90rpx 20rpx 0; /* 增加上边距，整体下移 */
  border-radius: 20rpx;
  padding: 20rpx 0; /* 添加上下内边距 */
  position: relative;
  z-index: 5;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}

/* 菜单区域 */
.menu-section.data-v-a67938aa {
  padding: 0;
}
.row.data-v-a67938aa {
  padding: 0;
  margin: 0;
}
.row-content.data-v-a67938aa {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 20rpx; /* 增加垂直内边距 */
  font-size: 28rpx;
  border-bottom: 1rpx solid #f0f0f0;
  min-height: 70rpx;
  transition: background-color 0.2s ease;
}
.row:active .row-content.data-v-a67938aa {
  background-color: #f8f9fa;
}
.row:last-child .row-content.data-v-a67938aa {
  border-bottom: none;
}

/* 分享按钮包装器 */
.share-wrapper.data-v-a67938aa {
  margin: 0;
  padding: 0;
}
.share-btn.data-v-a67938aa {
  background: transparent !important;
  border: none !important;
  padding: 0 !important;
  margin: 0 !important;
  line-height: normal !important;
  display: block !important;
  width: 100% !important;
}
.share-btn.data-v-a67938aa::after {
  border: none !important;
}
.icon.data-v-a67938aa {
  font-size: 36rpx; /* 稍微增大图标 */
  margin-right: 15rpx;
  width: 40rpx;
  text-align: center;
  transition: transform 0.2s ease;
}
.row:active .icon.data-v-a67938aa {
  transform: scale(1.1);
}
.text.data-v-a67938aa {
  color: #333;
  font-size: 28rpx;
  flex: 1;
  text-align: left;
}
.arrow.data-v-a67938aa {
  color: #ccc;
  font-size: 26rpx;
  margin-left: auto;
  transition: transform 0.2s ease;
}
.row:active .arrow.data-v-a67938aa {
  transform: translateX(5rpx);
}

/* 底部按钮 - 与菜单卡片分离，中间保持距离 */
.end.data-v-a67938aa {
  background-color: white;
  margin: 30rpx 20rpx 0; /* 增加上边距，与菜单卡片分离 */
  border-radius: 20rpx;
  padding: 0 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.05);
}
.action-btn.data-v-a67938aa {
  width: 100%;
  border: none;
  padding: 0;
  margin: 0;
}
.action-btn .row-content.data-v-a67938aa {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: 30rpx; /* 稍微增大字体 */
  font-weight: bold;
  border-radius: 12rpx;
  margin: 20rpx 0;
  padding: 25rpx 15rpx;
  border-bottom: none;
  transition: all 0.3s ease;
}
.login-btn .row-content.data-v-a67938aa {
  background: linear-gradient(135deg, #008c8c, #00a8a8);
  color: white;
}
.action-btn:last-child .row-content.data-v-a67938aa {
  border-bottom: none;
}

/* 页脚 */
.footer.data-v-a67938aa {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 30rpx 0;
  font-size: 22rpx;
  margin: 25rpx 0 0; /* 调整上边距 */
  color: #999;
}

/* 头像弹窗样式优化 */
.avatar-modal.data-v-a67938aa {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0, 0, 0, 0.4);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-content.data-v-a67938aa {
  background: white;
  border-radius: 20rpx;
  width: 90%;
  max-width: 600rpx;
  padding: 30rpx 25rpx;
  max-height: 70vh;
  overflow-y: auto;
}
.modal-header.data-v-a67938aa {
  display: flex;
  flex-direction: row;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 15rpx;
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}
.user-info-modal.data-v-a67938aa {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 20rpx;
  text-align: center;
}
.username.data-v-a67938aa {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  margin-bottom: 8rpx;
}
.user-id-modal.data-v-a67938aa {
  font-size: 22rpx;
  color: #666;
  background: #f5f5f5;
  padding: 5rpx 14rpx;
  border-radius: 8rpx;
}
.close.data-v-a67938aa {
  font-size: 38rpx;
  color: #999;
  padding: 8rpx;
  cursor: pointer;
  line-height: 1;
  transition: transform 0.2s ease;
}
.close.data-v-a67938aa:active {
  transform: scale(0.9);
}
.avatar-grid.data-v-a67938aa {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 15rpx;
}
.avatar-option.data-v-a67938aa {
  position: relative;
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  overflow: hidden;
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  transition: transform 0.2s ease;
}
.avatar-option.data-v-a67938aa:active {
  transform: scale(0.95);
}
.avatar-img.data-v-a67938aa {
  width: 100%;
  height: 100%;
  border-radius: 50%;
  transition: all 0.3s ease;
}
.avatar-img.selected.data-v-a67938aa {
  border: 3rpx solid #008c8c;
  box-shadow: 0 3rpx 10rpx rgba(0, 140, 140, 0.3);
}
.avatar-index.data-v-a67938aa {
  position: absolute;
  top: 3rpx;
  right: 3rpx;
  background: rgba(0, 0, 0, 0.5);
  color: white;
  font-size: 16rpx;
  width: 22rpx;
  height: 22rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
}
