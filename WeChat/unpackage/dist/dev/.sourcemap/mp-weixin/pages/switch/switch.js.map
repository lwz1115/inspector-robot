<template>
    <view class="switch-container">
        <!-- 自定义导航栏 -->
        <view class="custom-navbar">
            <view class="navbar-title">{{ currentTitle }}</view>
        </view>
        
        <!-- 滑动切换区域 -->
        <swiper 
            class="main-swiper" 
            :current="currentIndex" 
            @change="onSwiperChange"
            :duration="300"
            :style="{height: swiperHeight + 'px'}"
        >
            <!-- 设备页面 -->
            <swiper-item>
                <scroll-view class="page-scroll" scroll-y="true" :style="{height: scrollHeight + 'px'}">
                    <view class="page-content">
                        <text class="page-title">设备管理</text>
                        <view class="device-list">
                            <view class="device-item">
                                <text class="device-name">设备001</text>
                                <text class="device-status online">在线</text>
                            </view>
                            <view class="device-item">
                                <text class="device-name">设备002</text>
                                <text class="device-status offline">离线</text>
                            </view>
                            <view class="device-item">
                                <text class="device-name">设备003</text>
                                <text class="device-status online">在线</text>
                            </view>
                        </view>
                    </view>
                </scroll-view>
            </swiper-item>
            
            <!-- 导航页面 -->
            <swiper-item>
                <scroll-view class="page-scroll" scroll-y="true" :style="{height: scrollHeight + 'px'}">
                    <view class="page-content">
                        <text class="page-title">地图导航</text>
                        <view class="nav-content">
                            <image src="/static/地图-地标.png" class="nav-icon" mode="aspectFit"></image>
                            <text class="nav-text">点击开始导航</text>
                        </view>
                    </view>
                </scroll-view>
            </swiper-item>
            
            <!-- 我的页面 -->
            <swiper-item>
                <scroll-view class="page-scroll" scroll-y="true" :style="{height: scrollHeight + 'px'}">
                    <view class="page-content">
                        <text class="page-title">个人中心</text>
                        <view class="user-info">
                            <image src="/static/我的.png" class="avatar" mode="aspectFit"></image>
                            <view class="user-detail">
                                <text class="username">{{ username }}</text>
                                <text class="user-id">ID: {{ userId }}</text>
                            </view>
                        </view>
                        
                        <view class="menu-list">
                            <view class="menu-item" @click="goToSetting">
                                <text>系统设置</text>
                                <text class="arrow">></text>
                            </view>
                            <view class="menu-item" @click="goToAbout">
                                <text>关于我们</text>
                                <text class="arrow">></text>
                            </view>
                            <view class="menu-item logout-item" @click="logout">
                                <text>退出登录</text>
                                <text class="arrow">></text>
                            </view>
                        </view>
                    </view>
                </scroll-view>
            </swiper-item>
        </swiper>
        
        <!-- 自定义底部导航栏 -->
        <view class="custom-tabbar">
            <view 
                v-for="(item, index) in tabList" 
                :key="index"
                class="tab-item"
                :class="{ active: currentIndex === index }"
                @click="switchTab(index)"
            >
                <image 
                    class="tab-icon"
                    :src="currentIndex === index ? item.selectedIconPath : item.iconPath"
                    mode="aspectFit"
                ></image>
                <text class="tab-text">{{ item.text }}</text>
            </view>
        </view>
    </view>
</template>

<script lang="uts">
export default {
    data() {
        return {
            currentIndex: 0,
            username: '加载中...',
            userId: '--',
            swiperHeight: 0,
            scrollHeight: 0,
            tabList: [
                {
                    text: '设备',
                    iconPath: '/static/主界面.png',
                    selectedIconPath: '/static/主界面 (1).png',
                    page: 'sever'
                },
                {
                    text: '导航',
                    iconPath: '/static/地图-地标.png',
                    selectedIconPath: '/static/地图-地标 (1).png',
                    page: 'alarm'
                },
                {
                    text: '我的',
                    iconPath: '/static/我的.png',
                    selectedIconPath: '/static/我的 (1）.png',
                    page: 'profile'
                }
            ]
        }
    },
    
    computed: {
        currentTitle() {
            return this.tabList[this.currentIndex]?.text || '设备管理';
        }
    },
    
    onLoad(options) {
        uni.__f__('log','at pages/switch/switch.uvue:143','switch页面加载，参数:', options);
        
        // 计算高度
        this.calculateHeight();
        
        // 根据URL参数设置初始页面
        if (options.page) {
            const pageIndex = this.tabList.findIndex(item => item.page === options.page);
            if (pageIndex !== -1) {
                this.currentIndex = pageIndex;
                uni.__f__('log','at pages/switch/switch.uvue:153','设置初始页面:', options.page, '索引:', pageIndex);
            }
        }
        
        // 加载用户信息
        this.loadUserInfo();
    },
    
    onShow() {
        uni.__f__('log','at pages/switch/switch.uvue:162','switch页面显示');
        // 重新加载用户信息
        this.loadUserInfo();
    },
    
    onReady() {
        // 计算高度
        this.calculateHeight();
    },
    
    methods: {
        // 计算高度
        calculateHeight() {
            const systemInfo = uni.getSystemInfoSync();
            const windowHeight = systemInfo.windowHeight;
            const statusBarHeight = systemInfo.statusBarHeight || 0;
            const navbarHeight = 44; // 导航栏高度
            const tabbarHeight = 50; // 标签栏高度
            const safeBottom = systemInfo.safeAreaInsets?.bottom || 0;
            
            // 计算swiper高度
            this.swiperHeight = windowHeight - statusBarHeight - navbarHeight;
            // 计算scroll-view高度
            this.scrollHeight = this.swiperHeight - tabbarHeight - safeBottom;
            
            uni.__f__('log','at pages/switch/switch.uvue:187','高度计算:', {
                windowHeight,
                statusBarHeight,
                swiperHeight: this.swiperHeight,
                scrollHeight: this.scrollHeight
            });
        },
        
        // 加载用户信息
        loadUserInfo() {
            const savedUsername = uni.getStorageSync('currentUsername');
            const savedUserId = uni.getStorageSync('userId');
            
            if (savedUsername) {
                this.username = savedUsername;
            } else {
                this.username = '未登录用户';
            }
            
            if (savedUserId) {
                this.userId = savedUserId;
            } else {
                this.userId = '未登录';
            }
            
            uni.__f__('log','at pages/switch/switch.uvue:212','加载用户信息:', { username: this.username, userId: this.userId });
        },
        
        // 滑动切换事件
        onSwiperChange(e) {
            uni.__f__('log','at pages/switch/switch.uvue:217','滑动切换，当前索引:', e.detail.current);
            this.currentIndex = e.detail.current;
            this.updateUrl();
        },
        
        // 点击切换标签
        switchTab(index) {
            uni.__f__('log','at pages/switch/switch.uvue:224','点击切换标签，索引:', index);
            this.currentIndex = index;
            this.updateUrl();
        },
        
        // 更新URL参数
        updateUrl() {
            const page = this.tabList[this.currentIndex].page;
            uni.__f__('log','at pages/switch/switch.uvue:232','更新页面参数:', page);
            uni.setStorageSync('lastMainPage', page);
        },
        
        // 跳转到设置
        goToSetting() {
            uni.showToast({
                title: '设置功能开发中',
                icon: 'none'
            });
        },
        
        // 跳转到关于我们
        goToAbout() {
            uni.navigateTo({
                url: '/pages/about/about'
            });
        },
        
        // 退出登录
        logout() {
            uni.showModal({
                title: '确认退出',
                content: '确定要退出登录吗？',
                success: (res) => {
                    if (res.confirm) {
                        uni.__f__('log','at pages/switch/switch.uvue:258','用户确认退出登录');
                        
                        // 清除登录信息
                        uni.removeStorageSync('currentUsername');
                        uni.removeStorageSync('userId');
                        uni.removeStorageSync('token');
                        uni.removeStorageSync('loginTime');
                        
                        // 显示退出成功提示
                        uni.showToast({
                            title: '退出成功',
                            icon: 'success',
                            duration: 1500
                        });
                        
                        // 延迟跳转到登录页面
                        setTimeout(() => {
                            uni.redirectTo({
                                url: '/pages/index/index'
                            });
                        }, 1500);
                    } else {
                        uni.__f__('log','at pages/switch/switch.uvue:280','用户取消退出登录');
                    }
                }
            });
        }
    }
}
</script>

