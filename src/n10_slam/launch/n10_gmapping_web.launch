<launch>
    <arg name="stm32_port" default="/dev/ttyACM0"/>

    <param name="robot_description" textfile="$(find n10_slam)/urdf/robot.urdf"/>
    <node pkg="robot_state_publisher" type="robot_state_publisher" name="robot_state_publisher"/>

    <!-- 官方lslidar驱动 -->
    <node pkg="lslidar_driver" type="lslidar_driver_node" name="lslidar_driver_node" output="screen">
        <param name="lidar_name" value="N10"/>
        <param name="serial_port" value="/dev/ttyN10"/>
        <param name="interface_selection" value="serial"/>
        <param name="frame_id" value="laser_frame"/>
        <param name="scan_topic" value="scan"/>
        <param name="min_range" value="0.15"/>
        <param name="max_range" value="3.0"/>
        <param name="use_gps_ts" value="false"/>
        <param name="compensation" value="false"/>
        <param name="pubScan" value="true"/>
        <param name="pubPointCloud2" value="false"/>
    </node>

    <!-- STM32通信 -->
    <node pkg="packet_pkg" type="serial_node.py" name="jetbot_serial" output="screen">
        <param name="port" value="$(arg stm32_port)"/>
    </node>

    <!-- 里程计 -->
    <node pkg="n10_slam" type="odometry_node" name="odometry_node" output="screen"/>

    <!-- TF: 激光雷达旋转180度 -->
    <node pkg="tf" type="static_transform_publisher" name="base_to_laser"
          args="0 0 0.1 3.14159 0 0 base_link laser_frame 50"/>

    <!-- Gmapping -->
    <node pkg="gmapping" type="slam_gmapping" name="slam_gmapping" output="screen">
        <param name="base_frame" value="base_link"/>
        <param name="odom_frame" value="odom"/>
        <param name="map_frame" value="map"/>
        <remap from="scan" to="/scan"/>
        <param name="delta" value="0.02"/>
        <param name="map_update_interval" value="0.5"/>
        <param name="maxUrange" value="2.5"/>
        <param name="maxRange" value="3.0"/>
        <param name="minimumScore" value="50"/>
        <param name="linearUpdate" value="0.05"/>
        <param name="angularUpdate" value="0.05"/>
        <param name="particles" value="30"/>
        <param name="xmin" value="-5.0"/>
        <param name="ymin" value="-5.0"/>
        <param name="xmax" value="5.0"/>
        <param name="ymax" value="5.0"/>
    </node>

    <!-- 地图推送节点（不启动rviz，改用web前端显示） -->
    <!-- backend_url 改为运行 Spring Boot 的机器 IP -->
    <arg name="backend_url" default="http://192.168.1.103:8080/api/map/push"/>
    <node pkg="http_pkg" type="map_node.py" name="map_node" output="screen">
        <param name="backend_url" value="$(arg backend_url)"/>
    </node>

</launch>
