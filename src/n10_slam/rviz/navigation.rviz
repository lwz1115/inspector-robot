Panels:
  - Class: rviz/Displays
    Name: Displays
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz/Grid
      Name: Grid
      Enabled: true
    - Class: rviz/RobotModel
      Name: RobotModel
      Enabled: true
    - Class: rviz/LaserScan
      Name: LaserScan
      Enabled: true
      Topic: /scan
      Size (m): 0.03
    - Class: rviz/Map
      Name: OldMap
      Enabled: true
      Topic: /old_map
      Alpha: 0.3
    - Class: rviz/Map
      Name: NewMap
      Enabled: true
      Topic: /map
      Alpha: 0.7
    - Class: rviz/Path
      Name: GlobalPath
      Enabled: true
      Topic: /move_base/NavfnROS/plan
      Color: 0; 255; 0
    - Class: rviz/Path
      Name: LocalPath
      Enabled: true
      Topic: /move_base/DWAPlannerROS/local_plan
      Color: 255; 255; 0
    - Class: rviz/TF
      Name: TF
      Enabled: true
  Global Options:
    Fixed Frame: map
  Tools:
    - Class: rviz/MoveCamera
    - Class: rviz/SetInitialPose
      Topic: /initialpose
    - Class: rviz/SetGoal
      Topic: /move_base_simple/goal
  Views:
    Current:
      Class: rviz/Orbit
      Distance: 10
      Pitch: 1.5708
